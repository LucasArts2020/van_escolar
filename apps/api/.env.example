DATABASE_URL=postgresql://caminho:caminho_local@localhost:5432/caminho
WEB_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development
# Tokens de recuperação/convite ficam acessíveis apenas no terminal em desenvolvimento.
DEV_DELIVERY=console
REDIS_URL=redis://127.0.0.1:6379
# Processa a caixa de saída e BullMQ no backend, mesmo com o app fechado.
NOTIFICATIONS_WORKER=true
NOTIFICATIONS_QUEUE_PREFIX=caminho
# Ative somente depois de configurar EAS/FCM/APNs e registrar um aparelho.
EXPO_PUSH_ENABLED=false
# Preencha apenas se a segurança aprimorada do Expo Push estiver habilitada.
EXPO_ACCESS_TOKEN=
# Somente backend/manutenção. Gere segredo aleatório com pelo menos 32 caracteres.
# Não use NEXT_PUBLIC_* ou EXPO_PUBLIC_* para esta credencial.
OPERATIONS_TOKEN=
